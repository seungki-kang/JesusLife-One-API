# Copying this file does not create usable passwords. Run scripts.local_mysql prepare.
COMPLETION_STORE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
NN_DB=neorang_narang
NN_DB_USER=nn_app
NN_DB_PASSWORD=
LIFE_DIARY_DB=life_diary
LIFE_DIARY_DB_USER=life_diary_app
LIFE_DIARY_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# PostgreSQL configuration foundation only. Synthetic placeholders, no connection.
# Provision runtime and migration in separate environments; do not use in Flutter.
JESUSLIFE_POSTGRES_RUNTIME_DSN=postgresql://synthetic_runtime:synthetic_password@db.example.invalid/synthetic_db?sslmode=require
JESUSLIFE_POSTGRES_MIGRATION_DSN=postgresql://synthetic_migration:synthetic_other_password@db.example.invalid/synthetic_db?sslmode=require
